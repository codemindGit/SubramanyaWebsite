@model SubramanyaWebsite.Models.ServicePage
@{
    ViewData["Title"] = Model.Title;
}
<section class="service-hero"><div class="container"><div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a> <span aria-hidden="true">/</span> @Model.Title</div><div class="service-hero-grid"><div><span class="eyebrow"><i class="@Model.Icon"></i> @Model.Eyebrow</span><h1>@Model.Title</h1><p class="service-hero-copy">@Model.Summary</p><div class="hero-actions"><a class="button button-primary" href="/#contact">Ask about this service <i class="fa-solid fa-arrow-right"></i></a><a class="button button-secondary" href="tel:+919632554468"><i class="fa-solid fa-phone"></i> Call our team</a></div></div><img class="service-hero-image" src="@Url.Content(Model.Image)" alt="@Model.ImageAlt" /></div></div></section>
<section class="section section-white"><div class="container service-detail-grid"><div><span class="eyebrow">A personal approach</span><h2>@Model.IntroTitle</h2><p>@Model.Intro</p><ul class="included-list">@foreach (var feature in Model.Features){<li><i class="fa-solid fa-circle-check"></i><span>@feature</span></li>}</ul><p class="notice"><i class="fa-solid fa-circle-info"></i>Service details and availability are discussed with our care team based on your location and needs.</p></div><aside class="info-card"><span class="eyebrow">What matters to us</span><h3>Care should feel clear and considered.</h3><p>We take the time to understand what you need, answer your questions and discuss the next step with your family.</p><ul class="check-list">@foreach (var benefit in Model.Benefits){<li><i class="fa-solid fa-check"></i><span>@benefit</span></li>}</ul><a class="button button-primary" href="tel:+919632554468"><i class="fa-solid fa-phone"></i> Speak with our team</a></aside></div></section>
<section class="section"><div class="container"><div class="cta-panel"><div><h2>Let&apos;s talk about @Model.Title.ToLowerInvariant().</h2><p>Our Belagavi team can help you understand the options available.</p></div><a class="button" href="/#contact">Request a call back <i class="fa-solid fa-arrow-right"></i></a></div><div class="service-callout"><a class="text-link" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-arrow-left"></i> Back to all services</a></div></div></section>
