@model SubramanyaWebsite.Models.ServicePage
@{
    ViewData["Title"] = Model.Title + " in Belagavi";
    ViewData["Description"] = Model.MetaDescription;
}
<section class="service-hero"><div class="container"><div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a><span aria-hidden="true">/</span><a href="/#services">Services</a><span aria-hidden="true">/</span><span aria-current="page">@Model.Title</span></div><div class="service-hero-grid"><div><span class="eyebrow"><i class="@Model.Icon"></i> @Model.Eyebrow</span><h1>@Model.Title</h1><p class="service-hero-copy">@Model.Summary</p><div class="hero-actions"><a class="button button-primary" href="/?service=@Model.Slug#contact">Ask about this service <i class="fa-solid fa-arrow-right"></i></a><a class="button button-secondary" href="tel:+919632554468"><i class="fa-solid fa-phone"></i> Call our team</a></div></div><img class="service-hero-image" src="@Url.Content(Model.Image)" alt="@Model.ImageAlt" fetchpriority="high" /></div></div></section>
<section class="section section-white"><div class="container service-detail-grid"><div class="service-intro"><span class="eyebrow">A personal approach</span><h2>@Model.IntroTitle</h2><p>@Model.Intro</p><ul class="included-list">@foreach (var feature in Model.Features){<li><i class="fa-solid fa-circle-check"></i><span>@feature</span></li>}</ul>@if (!string.IsNullOrWhiteSpace(Model.ServiceNote)){<p class="notice"><i class="fa-solid fa-circle-info"></i>@Model.ServiceNote</p>}</div><aside class="info-card"><span class="eyebrow">What matters to us</span><h3>Care should feel clear and considered.</h3><p>We take time to understand your request, answer questions and confirm availability before making arrangements.</p><ul class="check-list">@foreach (var benefit in Model.Benefits){<li><i class="fa-solid fa-check"></i><span>@benefit</span></li>}</ul><a class="button button-primary" href="tel:+919632554468"><i class="fa-solid fa-phone"></i> Speak with our team</a></aside></div></section>
@if (Model.EquipmentCategories.Length > 0){<section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">Equipment categories to enquire about</span><h2>What are you looking for?</h2></div><p>These categories are examples only. Contact us to verify current stock, exact models, specifications, terms and availability.</p></div><div class="equipment-grid">@foreach (var category in Model.EquipmentCategories){<article class="equipment-card"><img src="@Url.Content(category.Image)" alt="@category.ImageAlt" loading="lazy" /><div class="equipment-card-body"><span class="eyebrow">Availability enquiry</span><h3>@category.Title</h3><p>@category.Description</p><ul>@foreach (var item in category.Examples){<li>@item</li>}</ul><a class="text-link" href="/?service=medical-equipment-rental#contact">Ask if available <i class="fa-solid fa-arrow-right"></i></a></div></article>}</div></div></section>}
<section class="section section-tint"><div class="container"><div class="section-heading"><div><span class="eyebrow">The process</span><h2>Simple steps.<br />Clear confirmation.</h2></div><p>Our team will confirm the scope and availability for your specific request.</p></div><ol class="service-steps">@for (var i = 0; i < Model.Steps.Length; i++){<li><span class="step-number">@((i + 1).ToString("00"))</span><p>@Model.Steps[i]</p></li>}</ol></div></section>
<section class="section"><div class="container"><div class="service-content-grid">@foreach (var contentBlock in Model.Sections){<article class="service-content-card"><span class="content-mark"><i class="fa-solid fa-plus"></i></span><h2>@contentBlock.Title</h2><p>@contentBlock.Body</p>@if (contentBlock.Points.Length > 0){<ul class="included-list">@foreach (var point in contentBlock.Points){<li><i class="fa-solid fa-circle-check"></i><span>@point</span></li>}</ul>}</article>}</div></div></section>
<section class="section section-white"><div class="container"><div class="cta-panel"><div><span class="eyebrow">Local support in Belagavi</span><h2>Have a question about @Model.Title.ToLowerInvariant()?</h2><p>Talk with our team about your needs and ask us to confirm availability and next steps.</p></div><div class="cta-actions"><a class="button button-light" href="tel:+919632554468"><i class="fa-solid fa-phone"></i> Call now</a><a class="button button-outline-light" href="https://wa.me/919632554468" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a></div></div><div class="service-callout"><a class="text-link" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-arrow-left"></i> Back to all services</a><a class="text-link" href="/#contact">Request a call back <i class="fa-solid fa-arrow-right"></i></a></div></div></section>
