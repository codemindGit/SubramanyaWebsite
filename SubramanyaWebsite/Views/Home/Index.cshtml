@{
    ViewData["Title"] = "Home Nursing, Elder Care & Patient Services";
}
<section class="hero">
    <div class="container hero-grid">
        <div>
            <span class="eyebrow"><i class="fa-solid fa-heart-pulse"></i> Thoughtful healthcare, close to home</span>
            <h1>Care that feels <em>close to home.</em></h1>
            <p class="hero-copy">From skilled nursing at home to dependable support for older adults, we help Belagavi families find the right care—with dignity, warmth and a real person to call.</p>
            <div class="hero-actions"><a class="button button-primary" href="#services">Explore our care services <i class="fa-solid fa-arrow-right"></i></a><a class="button button-secondary" href="tel:+919632554468"><i class="fa-solid fa-phone"></i> Speak with our team</a></div>
            <div class="hero-note"><span class="avatar-stack"><span><i class="fa-solid fa-user-nurse"></i></span><span><i class="fa-solid fa-heart"></i></span><span><i class="fa-solid fa-house-medical"></i></span></span><span><strong>Local care, personal attention</strong><br />Supporting families across Belagavi</span></div>
        </div>
        <div class="hero-visual"><img class="hero-photo" src="~/images/home-nursing.png" alt="A care professional providing attentive support at home" /><div class="image-tag"><span class="image-tag-icon"><i class="fa-solid fa-house-medical"></i></span><span><strong>Care, on your terms</strong><small>At home, in hospital, or on the move</small></span></div></div>
    </div>
</section>
<section class="proof-strip" aria-label="Our approach"><div class="container proof-grid"><div class="proof-item"><i class="proof-icon fa-solid fa-user-nurse"></i><span><strong>Trained care team</strong><small>Support matched to your needs</small></span></div><div class="proof-item"><i class="proof-icon fa-solid fa-clock"></i><span><strong>Available 24/7</strong><small>Talk to us whenever you need</small></span></div><div class="proof-item"><i class="proof-icon fa-solid fa-location-dot"></i><span><strong>Belagavi focused</strong><small>Local coordination and care</small></span></div><div class="proof-item"><i class="proof-icon fa-solid fa-hand-holding-heart"></i><span><strong>People come first</strong><small>Respectful, family-centred support</small></span></div></div></section>
<section class="section" id="services"><div class="container"><div class="section-heading center"><span class="eyebrow">Care for every need</span><h2>One trusted team.<br />Support for every step.</h2><p>Explore dedicated service pages to understand what each option includes and find the right next step for your family.</p></div>
<div class="service-grid">
<a class="service-card featured" asp-controller="Home" asp-action="Service" asp-route-slug="home-nursing"><span class="service-icon"><i class="fa-solid fa-user-nurse"></i></span><h3>Home nursing</h3><p>Skilled nursing support and recovery care in the comfort of home.</p><span class="text-link">Explore nursing care <i class="fa-solid fa-arrow-right"></i></span></a>
<a class="service-card" asp-controller="Home" asp-action="Service" asp-route-slug="elder-care"><span class="service-icon"><i class="fa-solid fa-person-cane"></i></span><h3>Old age care</h3><p>Patient companionship and everyday assistance, centred on dignity and independence.</p><span class="text-link">Explore elder care <i class="fa-solid fa-arrow-right"></i></span></a>
<a class="service-card" asp-controller="Home" asp-action="Service" asp-route-slug="ambulance"><span class="service-icon"><i class="fa-solid fa-truck-medical"></i></span><h3>Ambulance</h3><p>Speak with our team to coordinate ambulance and patient transfer support.</p><span class="text-link">Ambulance information <i class="fa-solid fa-arrow-right"></i></span></a>
<a class="service-card" asp-controller="Home" asp-action="Service" asp-route-slug="medical-equipment-rental"><span class="service-icon"><i class="fa-solid fa-bed-pulse"></i></span><h3>Surgical equipment on rent</h3><p>Ask about medical and recovery equipment rental for home care needs.</p><span class="text-link">View rental support <i class="fa-solid fa-arrow-right"></i></span></a>
<a class="service-card" asp-controller="Home" asp-action="Service" asp-route-slug="hospital-staffing"><span class="service-icon"><i class="fa-solid fa-people-group"></i></span><h3>Staff for hospitals</h3><p>Healthcare staffing support for hospitals and care facilities.</p><span class="text-link">Discuss staffing <i class="fa-solid fa-arrow-right"></i></span></a>
<a class="service-card" asp-controller="Home" asp-action="Service" asp-route-slug="patient-visits"><span class="service-icon"><i class="fa-solid fa-house-medical-circle-check"></i></span><h3>Patient visits</h3><p>Arrange a patient visit and discuss the support that would help at home.</p><span class="text-link">Arrange a visit <i class="fa-solid fa-arrow-right"></i></span></a>
</div></div></section>
<section class="feature-band"><div class="container feature-grid"><div class="feature-photo-wrap"><img class="feature-photo" src="~/images/elder-care.png" alt="An older adult receiving kind, attentive care" /><div class="feature-label"><i class="fa-solid fa-heart"></i> Personal care, with dignity</div></div><div class="feature-content"><span class="eyebrow">A more reassuring way to care</span><h2>Every family deserves a little more peace of mind.</h2><p>Finding care can feel overwhelming. Our local team takes time to understand your situation, explain your options and help coordinate the support you need.</p><ul class="check-list"><li><i class="fa-solid fa-circle-check"></i><span>Begin with a conversation about your loved one and their needs</span></li><li><i class="fa-solid fa-circle-check"></i><span>Explore care options with clear, personal guidance</span></li><li><i class="fa-solid fa-circle-check"></i><span>Stay connected with a team that understands your community</span></li></ul><a class="button button-primary" asp-controller="Home" asp-action="Service" asp-route-slug="elder-care">Discover old age care <i class="fa-solid fa-arrow-right"></i></a></div></div></section>
<section class="section section-white"><div class="container"><div class="section-heading center"><span class="eyebrow">Getting started</span><h2>A simple first step toward better support.</h2><p>We make it easier to find out what care could look like for you.</p></div><div class="steps"><article class="step"><span class="step-number">01 — TALK</span><h3>Tell us what is happening</h3><p>Call or send a request. Share as much or as little as you feel comfortable with.</p></article><article class="step"><span class="step-number">02 — UNDERSTAND</span><h3>Explore the right care</h3><p>Our team listens and discusses services that may suit your situation.</p></article><article class="step"><span class="step-number">03 — COORDINATE</span><h3>Plan your next step</h3><p>We help coordinate support and explain what to expect before you begin.</p></article></div></div></section>
<section class="section"><div class="container"><div class="cta-panel"><div><h2>Not sure where to begin?</h2><p>Talk with our Belagavi care team and tell us what kind of support you are looking for.</p></div><a class="button" href="tel:+919632554468"><i class="fa-solid fa-phone"></i> Call +91 96325 54468</a></div></div></section>
<section class="section section-white" id="contact"><div class="container contact-grid"><div class="contact-copy"><span class="eyebrow">We are here to help</span><h2>Let&apos;s talk about the care you need.</h2><p>Reach our team in Belagavi to ask about services, availability or the next step for your family.</p><div class="contact-detail"><i class="fa-solid fa-phone"></i><div><strong>Call our care team</strong><a href="tel:+919632554468">+91 96325 54468</a> · <a href="tel:+919739213907">+91 97392 13907</a></div></div><div class="contact-detail"><i class="fa-solid fa-envelope"></i><div><strong>Email</strong><a href="mailto:homecare@subramanyafoundation.com">homecare@subramanyafoundation.com</a></div></div><div class="contact-detail"><i class="fa-solid fa-location-dot"></i><div><strong>Serving Belagavi</strong><span>Angol, Bhagya Nagar and surrounding neighbourhoods</span></div></div></div>
<form class="care-form" id="careForm" onsubmit="submitCareForm(event)">@Html.AntiForgeryToken()<h3>Request a call back</h3><p>Leave your details and the service you are interested in.</p><div class="form-grid"><div class="form-field"><label for="Name">Your name *</label><input id="Name" name="Name" maxlength="120" autocomplete="name" required /></div><div class="form-field"><label for="Phone">Phone number *</label><input id="Phone" name="Phone" type="tel" maxlength="30" autocomplete="tel" required /></div><div class="form-field"><label for="Email">Email address *</label><input id="Email" name="Email" type="email" maxlength="254" autocomplete="email" required /></div><div class="form-field"><label for="PatientName">Patient name *</label><input id="PatientName" name="PatientName" maxlength="120" required /></div><div class="form-field"><label for="Location">Area in Belagavi</label><input id="Location" name="Location" maxlength="160" placeholder="e.g. Tilakwadi" /></div><div class="form-field"><label for="RequiredService">Service *</label><select id="RequiredService" name="RequiredService" required><option value="Home Nursing Care">Home nursing</option><option value="Old Age Care">Old age care</option><option value="Ambulance Service">Ambulance</option><option value="Surgical Material Rental">Surgical material on rent</option><option value="Hospital Staffing">Hospital staffing</option><option value="Patient Visit">Patient visit</option></select></div><div class="form-field" style="position:absolute;left:-9999px" aria-hidden="true"><label for="Website">Website</label><input id="Website" name="Website" tabindex="-1" autocomplete="off" /></div></div><button class="button button-primary" type="submit">Send care request <i class="fa-solid fa-arrow-right"></i></button><div class="form-result" id="formResult" role="status" aria-live="polite"></div></form></div></section>
